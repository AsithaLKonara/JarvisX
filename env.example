# JarvisX V2 Environment Configuration

# ═══════════════════════════════════════════════════════════════
# AI/LLM Configuration
# ═══════════════════════════════════════════════════════════════

# Cloud LLM Settings
USE_CLOUD_LLM=false
CLOUD_LLM_URL=https://AsithaLKonara-jarvis-llm-brain.hf.space

# OpenAI API (if using GPT models)
OPENAI_API_KEY=your_openai_key_here

# Hugging Face
HUGGINGFACE_TOKEN=your_hf_token_here

# ═══════════════════════════════════════════════════════════════
# Voice & Speech Configuration
# ═══════════════════════════════════════════════════════════════

# Text-to-Speech (TTS)
ENABLE_TTS=true
TTS_ENGINE=pyttsx3        # Options: pyttsx3, gtts, elevenlabs
TTS_RATE=150             # Speech rate (words per minute)
TTS_VOLUME=1.0           # Volume (0.0 to 1.0)
TTS_LANGUAGE=en          # Language code (en, si)

# ElevenLabs (premium TTS - optional)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=Adam

# Speech-to-Text (STT)
ENABLE_STT=false
STT_ENGINE=google        # Options: google, vosk
STT_LANGUAGE=en          # Language code (en, si)

# ═══════════════════════════════════════════════════════════════
# System Configuration
# ═══════════════════════════════════════════════════════════════

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log

# Performance
MAX_HISTORY=5
CACHE_DIR=cache

# ═══════════════════════════════════════════════════════════════
# Business Mode Configuration
# ═══════════════════════════════════════════════════════════════

# Company Info
COMPANY_NAME=Your Company
COMPANY_EMAIL=info@yourcompany.com
COMPANY_PHONE=+94-123-456-789

# Invoice Settings
INVOICE_PREFIX=INV
INVOICE_TAX_RATE=0.0

# ═══════════════════════════════════════════════════════════════
# Mode Preferences
# ═══════════════════════════════════════════════════════════════

# Default Mode
DEFAULT_MODE=casual      # Options: engineer, system, designer, editor, business, casual

# Feature Toggles
ENABLE_SYSTEM_CONTROL=true
ENABLE_FILE_OPERATIONS=true
ENABLE_IDE_INTEGRATION=true

